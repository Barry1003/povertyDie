# Configure secrets in Vercel > Project > Settings > Environment Variables.
# Server-only Neon PostgreSQL pooled connection string (not NEXT_PUBLIC_).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Enable Managed Better Auth in the Neon Console and copy the branch's Auth URL.
NEON_AUTH_BASE_URL=https://ep-example.neonauth.region.aws.neon.tech/neondb/auth

# The Next.js app signs its own session cache cookies. At least 32 characters.
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Comma-separated friends' verified Google email addresses (application access gate).
# Google sign-in may create Neon Auth accounts; only these emails can access Poverty Die.
ALLOWED_EMAILS=friend1@example.com,friend2@example.com
