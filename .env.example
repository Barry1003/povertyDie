# Configure these in Vercel > Project > Settings > Environment Variables.
# Use a pooled Neon connection URL for serverless connections.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Google Cloud Console OAuth 2.0 Web application credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated invited Google account addresses. Keep this set; no public signups.
ALLOWED_EMAILS=friend1@example.com,friend2@example.com
